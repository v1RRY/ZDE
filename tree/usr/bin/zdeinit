#!/usr/bin/python3
import sys
import subprocess
import json
import os
import tkinter
from tkinter import messagebox
import shutil
import psutil

processes = []

if len(sys.argv) == 2:
    config_file = open(os.path.expanduser(sys.argv[1]))
    config = json.loads(config_file.read())
    config_file.close()
else:
    try:
        config_file = open(os.path.expanduser("~/.config/zde/config.json"))
        config = json.loads(config_file.read())
        config_file.close()
    except FileNotFoundError:
        messagebox.showwarning("ZDE", "No config file found. Creating new.")
        try:
            os.makedirs(os.path.dirname(os.path.expanduser("~/.config/zde/config.json")), exist_ok=True)
            shutil.copyfile("/etc/xdg/zde/config.json", os.path.expanduser("~/.config/zde/config.json"))
        except PermissionError:
            messagebox.showerror("ZDE", "Can't create config file (permission error). Try assigning owners to your .config directory. Press OK to exit")
            exit(1)
        except FileNotFoundError:
            messagebox.showerror("ZDE", "Can't copy config file (no system-wide config file). Your install of ZDE is incorrect. Try reinstalling. Press OK to exit")
            exit(1)
        config_file = open(os.path.expanduser("~/.config/zde/config.json"))
        config = json.loads(config_file.read())
        config_file.close()

if config["wallpaper_type"] == "color":
    p1 = subprocess.Popen("swaybg -c " + config["wallpaper"], shell=True)
    processes.append(p1)
elif config["wallpaper_type"] == "image":
    p1 = subprocess.Popen("swaybg -i \"" + config["wallpaper"]["path"] + "\" -m " + config["wallpaper"]["mode"], shell=True)
    processes.append(p1)
else:
    messagebox.showerror("Your config file has an error. Incorrect wallpaper type (requestes color/image, got " + config["wallpaper_type"] + ")")

p2 = subprocess.Popen("nwg-panel", shell=True)
processes.append(p2)

p3 = subprocess.Popen("mako", shell=True)
processes.append(p3)

psutil.wait_procs(processes)
